# Скопируйте в .env (chmod 600) и заполните. Реальные значения НИКОГДА не коммитьте.

# --- обязательное ---
# Пароль входа в /admin (минимум 12 символов). Либо вместо него ADMIN_PASSWORD_HASH (см. README: python -m app.hashpw)
ADMIN_PASSWORD=change-me
# ADMIN_PASSWORD_HASH=
# Секрет для подписи сессий и хеша IP: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# --- сайты, которым разрешено писать в журнал (через запятую; * — метка хоста, :* — любой порт) ---
ALLOWED_ORIGINS=https://joliks.github.io,https://*.pages.dev,http://127.0.0.1:*
# ALLOWED_ORIGINS=https://joliks.github.io,https://your-project.pages.dev,https://chat.your-domain.example

# --- хранение ---
DB_PATH=data/fah.db
RETENTION_DAYS=90            # 0 = не удалять автоматически
MAX_TEXT_CHARS=20000
# MAX_DB_MB=2048

# --- лимиты ---
RATE_LIMIT_PER_MIN=30        # запросов /api/log в минуту с одного адреса
# MAX_BYTES_PER_IP_DAY=20000000
# LOGIN_MAX_FAILS=5
# LOGIN_LOCK_MINUTES=15

# --- за обратным прокси (Caddy/nginx/Cloudflare) ---
TRUST_PROXY=1                # 1 = доверять CF-Connecting-IP / X-Forwarded-For (ТОЛЬКО если порт приложения закрыт снаружи!)
COOKIE_SECURE=1              # 0 — только для локальной разработки по http

# --- запуск ---
HOST=127.0.0.1
PORT=8080
